# Mistral API key — get from https://console.mistral.ai/
# Required: the app raises LLMConfigError on any LLM call without this.
MISTRAL_API_KEY=

# Google API key (Gemini) — get from https://aistudio.google.com/apikey
# Required when filter rules (GOOGLE_FILTER_MODEL_DEFAULT) are in use.
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Below: OPTIONAL overrides. Each has a code-side default (see llm_client.py:
# DEFAULT_MODELS, DEFAULT_RATE_LIMITS, DEFAULT_MISTRAL_RPS, DEFAULT_GOOGLE_RPS).
# Uncomment to override.
# ---------------------------------------------------------------------------

# Mistral model aliases
# MISTRAL_MODEL_SMALL=ministral-3b-2512
# MISTRAL_MODEL_MEDIUM=mistral-medium-latest
# MISTRAL_MODEL_LARGE=mistral-large-2512

# Per-alias rate limits (requests-per-second)
# MISTRAL_RATE_LIMIT_SMALL=10
# MISTRAL_RATE_LIMIT_MEDIUM=0.5
# MISTRAL_RATE_LIMIT_LARGE=0.067

# Rate limits for non-aliased calls
# MISTRAL_RATE_LIMIT_CUSTOM=0.5
# GOOGLE_RATE_LIMIT=0.5
