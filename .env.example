# Mistral API key — get from https://console.mistral.ai/
# Required: the app raises LLMConfigError on any LLM call without this.
MISTRAL_API_KEY=

# Google API key (Gemini) — get from https://aistudio.google.com/apikey
# Required when filter rules (GOOGLE_FILTER_MODEL_DEFAULT) are in use.
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Below: OPTIONAL overrides. Each has a code-side default (see llm_client.py:
# DEFAULT_RATE_LIMITS, DEFAULT_MISTRAL_RPS, DEFAULT_GOOGLE_RPS).
# API keys above are required. Rate-limit vars below are optional.
# Model choice is NOT set here — see the flow diagram below.
# Uncomment a rate-limit line to override.
# ---------------------------------------------------------------------------

# Per-alias rate limits (requests-per-second). Used ONLY by the legacy
# model_alias path: LLMClient(model_alias="small"/"medium").
#   env set   -> use env value
#   env empty -> use DEFAULT_RATE_LIMITS (small=10, medium=0.5)
# MISTRAL_RATE_LIMIT_SMALL=10
# MISTRAL_RATE_LIMIT_MEDIUM=0.5

# Rate limits for non-aliased calls (LLMClient(provider, model_id)).
#   Mistral: env MISTRAL_RATE_LIMIT_CUSTOM set -> use it, else 0.5
#   Google:  env GOOGLE_RATE_LIMIT set -> use it, else 0.5
# MISTRAL_RATE_LIMIT_CUSTOM=0.5
# GOOGLE_RATE_LIMIT=0.5

# Model choice is NOT set here — see docs/technical/LLM_Pipeline.md
# §Configuration → "Which default wins?" flow diagram.
